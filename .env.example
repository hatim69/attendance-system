# Copy to .env and fill in. Never commit .env.
DOMAIN=attendance.example.com
PUBLIC_DOMAIN=attendance.example.com
# Admin dashboard login: user "admin" + this password. Use a long one.
ADMIN_PASSWORD=change-me-to-a-long-password
# Signs employee app logins. Generate: openssl rand -hex 32
SECRET_KEY=
TIMEZONE=Asia/Kolkata
SHIFT_START=09:00
GRACE_MINUTES=10
# block = refuse app punches outside every site, flag = accept but mark them
GEOFENCE_MODE=block
# Only accept fingerprint-device scans from these device ids (the dev_id seen in the log, e.g. RSS202506120926)
FKWEB_DEVICES=RSS202506120926
