# Copy to .env and fill in. Never commit .env.
DOMAIN=attendance.example.com
PUBLIC_DOMAIN=attendance.example.com
# Creates the first admin login (user "admin") the FIRST time the app starts with no users. After that, manage users in
# the dashboard (Users tab). Lost the password? Run: docker compose exec app python scripts/reset_admin.py admin 'new password'
ADMIN_PASSWORD=change-me-to-a-long-password
# Signs employee app logins. Generate: openssl rand -hex 32
SECRET_KEY=
TIMEZONE=Asia/Kolkata
# block = refuse app punches outside every site, flag = accept but mark them
GEOFENCE_MODE=block
# Only accept scans from these devices (comma separated). Ranigunz=...920, Qutbi Arcade=...926, Mumbai Office=...928
FKWEB_DEVICES=RSS202506120920,RSS202506120926,RSS202506120928
# Shown on payslips
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=
# Play Store app (see PLAY_STORE.md): signing-key SHA-256 fingerprint(s) from Play Console > App integrity, comma separated
ANDROID_PACKAGE=com.madarwala.attendance
ANDROID_CERT_SHA256=
# Contact shown on the privacy policy page (https://<your domain>/privacy)
PRIVACY_CONTACT=
# Nightly backup at 2 AM, emailed as a password-protected zip (open with 7-Zip / WinRAR)
BACKUP_EMAIL_TO=hr@madarwala.com
BACKUP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Late arrivals: an e-mail the same day to the employee (work e-mail), their team lead (e-mail on their login) and HR.
# Uses the SMTP settings above. Set LATE_EMAILS=0 to switch it off.
HR_EMAIL=hr@madarwala.com
LATE_EMAILS=1
# Weekly attendance report (Excel) to HR_EMAIL every Monday from this hour. WEEKLY_REPORT=0 switches it off.
WEEKLY_REPORT=1
WEEKLY_REPORT_HOUR=8
